# Supabase loyihasi: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# FAQAT serverda ishlatiladi (foydalanuvchi yaratish uchun). Hech qachon NEXT_PUBLIC_ bilan boshlamang.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# scripts/create-admin.mjs uchun (birinchi super administrator)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
